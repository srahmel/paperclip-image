+// @vitest-environment jsdom
+import { createRoot, type Root } from "react-dom/client";
+import { flushSync } from "react-dom";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { IssueImageGalleryActions } from "./IssueImageGalleryActions";
+
+const mocks = vi.hoisted(() => ({
+  slots: [] as Record<string, unknown>[],
+  mount: vi.fn(),
+}));
+vi.mock("@/plugins/slots", () => ({
+  usePluginSlots: () => ({ slots: mocks.slots }),
+  PluginSlotMount: (props: unknown) => {
+    mocks.mount(props);
+    return <span>Plugin action</span>;
+  },
+}));
+let root: Root;
+beforeEach(() => {
+  const container = document.createElement("div");
+  document.body.append(container);
+  root = createRoot(container);
+  mocks.mount.mockClear();
+  mocks.slots = [];
+});
+afterEach(() => {
+  flushSync(() => root.unmount());
+  document.body.innerHTML = "";
+});
+const props = {
+  companyId: "company",
+  companyPrefix: "HUM",
+  issueId: "issue",
+  projectId: null,
+  item: {
+    id: "image-2",
+    contentPath: "/api/attachments/image-2/content",
+    contentType: "image/png",
+    originalFilename: "second.png",
+  },
+};
+it("keeps native viewing available when no plugin is installed", () => {
+  flushSync(() => root.render(<IssueImageGalleryActions {...props} />));
+  expect(mocks.mount).not.toHaveBeenCalled();
+});
+it("forwards selected image and company scope through the existing toolbar slot", () => {
+  mocks.slots = [{ pluginId: "plugin", id: "review" }];
+  flushSync(() => root.render(<IssueImageGalleryActions {...props} />));
+  expect(mocks.mount).toHaveBeenLastCalledWith(
+    expect.objectContaining({
+      context: expect.objectContaining({
+        companyId: "company",
+        companyPrefix: "HUM",
+        entityId: "issue",
+      }),
+      componentProps: { imageGallery: props.item },
+    }),
+  );
+});
+it("does not offer image actions for a video", () => {
+  mocks.slots = [{ pluginId: "plugin", id: "review" }];
+  flushSync(() =>
+    root.render(
+      <IssueImageGalleryActions
+        {...props}
+        item={{ ...props.item, contentType: "video/webm" }}
+      />,
+    ),
+  );
+  expect(mocks.mount).not.toHaveBeenCalled();
+});
+it("offers gallery actions for legacy PNG files stored as generic binary", () => {
+  mocks.slots = [{ pluginId: "plugin", id: "review" }];
+  flushSync(() =>
+    root.render(
+      <IssueImageGalleryActions
+        {...props}
+        item={{ ...props.item, contentType: "application/octet-stream" }}
+      />,
+    ),
+  );
+  expect(mocks.mount).toHaveBeenCalled();
+});
