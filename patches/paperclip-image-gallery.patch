@@ -0,0 +1,46 @@
+import { PluginSlotMount, usePluginSlots } from "@/plugins/slots";
+import type { GalleryMediaItem } from "./ImageGalleryModal";
+import { isImageLikeOutput } from "@/lib/issue-output";
+
+/** Reuse the issue toolbar extension point with the selected gallery image as host props. */
+export function IssueImageGalleryActions({
+  companyId,
+  companyPrefix,
+  issueId,
+  projectId,
+  item,
+}: {
+  companyId: string;
+  companyPrefix: string | null;
+  issueId: string;
+  projectId: string | null;
+  item: GalleryMediaItem;
+}) {
+  const { slots } = usePluginSlots({
+    slotTypes: ["toolbarButton"],
+    entityType: "issue",
+    companyId,
+  });
+  if (!isImageLikeOutput(item.contentType, item.originalFilename)) return null;
+  return slots.map((slot) => (
+    <PluginSlotMount
+      key={`${slot.pluginId}:${slot.id}`}
+      slot={slot}
+      context={{
+        companyId,
+        companyPrefix,
+        entityId: issueId,
+        entityType: "issue",
+        projectId,
+      }}
+      componentProps={{
+        imageGallery: {
+          id: item.id,
+          contentPath: item.contentPath,
+          contentType: item.contentType,
+          originalFilename: item.originalFilename,
+        },
+      }}
+    />
+  ));
+}
