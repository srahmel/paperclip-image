index 0000000000..aa2c92c5b2
--- /dev/null
+++ b/ui/src/components/ImageGalleryViewport.tsx
@@ -0,0 +1,180 @@
+import {
+  useCallback,
+  useEffect,
+  useRef,
+  useState,
+  type PointerEvent,
+} from "react";
+
+type Point = { x: number; y: number };
+type View = Point & { scale: number };
+type Size = { width: number; height: number };
+const boundedScale = (scale: number) => Math.min(16, Math.max(0.01, scale));
+
+function atPoint(view: View, point: Point, scale: number): View {
+  const next = boundedScale(scale),
+    ratio = next / view.scale;
+  return {
+    scale: next,
+    x: point.x - (point.x - view.x) * ratio,
+    y: point.y - (point.y - view.y) * ratio,
+  };
+}
+
+/** Zoom geometry stays in original image pixels; the host supplies presentation tokens. */
+export function useGalleryImageView(contentPath: string, open: boolean) {
+  const viewport = useRef<HTMLDivElement>(null);
+  const [element, setElement] = useState<HTMLDivElement | null>(null);
+  const attachViewport = useCallback((node: HTMLDivElement | null) => {
+    viewport.current = node;
+    setElement(node);
+  }, []);
+  const imageSize = useRef<Size | null>(null);
+  const fitted = useRef(true);
+  const [view, setView] = useState<View>({ scale: 1, x: 0, y: 0 });
+  const viewRef = useRef(view);
+  viewRef.current = view;
+  const pointers = useRef(new Map<number, Point>());
+  const gesture = useRef<{
+    point: Point;
+    view: View;
+    distance: number | null;
+  } | null>(null);
+
+  const fit = useCallback(() => {
+    const area = viewport.current,
+      size = imageSize.current;
+    if (!area || !size || !area.clientWidth || !area.clientHeight) return;
+    const scale = boundedScale(
+      Math.min(
+        area.clientWidth / size.width,
+        area.clientHeight / size.height,
+        1,
+      ),
+    );
+    fitted.current = true;
+    setView({
+      scale,
+      x: (area.clientWidth - size.width * scale) / 2,
+      y: (area.clientHeight - size.height * scale) / 2,
+    });
+  }, []);
+  const zoom = useCallback((factor: number, point?: Point) => {
+    const area = viewport.current;
+    if (!area || !imageSize.current) return;
+    fitted.current = false;
+    setView((value) =>
+      atPoint(
+        value,
+        point ?? { x: area.clientWidth / 2, y: area.clientHeight / 2 },
+        value.scale * factor,
+      ),
+    );
+  }, []);
+  const actualSize = useCallback(() => {
+    const area = viewport.current;
+    if (!area || !imageSize.current) return;
+    fitted.current = false;
+    setView((value) =>
+      atPoint(value, { x: area.clientWidth / 2, y: area.clientHeight / 2 }, 1),
+    );
+  }, []);
+  useEffect(() => {
+    imageSize.current = null;
+    pointers.current.clear();
+    gesture.current = null;
+    fitted.current = true;
+    setView({ scale: 1, x: 0, y: 0 });
+  }, [contentPath, open]);
+  useEffect(() => {
+    const area = element;
+    if (!area || !open) return;
+    const observer =
+      typeof ResizeObserver === "undefined"
+        ? null
+        : new ResizeObserver(() => {
+            if (fitted.current) fit();
+          });
+    observer?.observe(area);
+    const wheel = (event: WheelEvent) => {
+      event.preventDefault();
+      const rect = area.getBoundingClientRect();
+      zoom(Math.exp(-Math.min(100, Math.max(-100, event.deltaY)) * 0.008), {
+        x: event.clientX - rect.left,
+        y: event.clientY - rect.top,
+      });
+    };
+    area.addEventListener("wheel", wheel, { passive: false });
+    return () => {
+      observer?.disconnect();
+      area.removeEventListener("wheel", wheel);
+    };
+  }, [element, contentPath, open, fit, zoom]);
+  const onLoad = (image: HTMLImageElement) => {
+    imageSize.current = {
+      width: image.naturalWidth,
+      height: image.naturalHeight,
+    };
+    fit();
+  };
+  const point = (event: PointerEvent<HTMLDivElement>): Point => {
+    const rect = event.currentTarget.getBoundingClientRect();
+    return { x: event.clientX - rect.left, y: event.clientY - rect.top };
+  };
+  const startGesture = () => {
+    const [a, b] = [...pointers.current.values()];
+    gesture.current = a
+      ? {
+          point: b ? { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 } : a,
+          view: viewRef.current,
+          distance: b ? Math.hypot(b.x - a.x, b.y - a.y) : null,
+        }
+      : null;
+  };
+  const onPointerDown = (event: PointerEvent<HTMLDivElement>) => {
+    if (event.button !== 0 || !imageSize.current) return;
+    event.preventDefault();
+    event.currentTarget.focus({ preventScroll: true });
+    event.currentTarget.setPointerCapture(event.pointerId);
+    pointers.current.set(event.pointerId, point(event));
+    startGesture();
+  };
+  const onPointerMove = (event: PointerEvent<HTMLDivElement>) => {
+    if (!pointers.current.has(event.pointerId)) return;
+    pointers.current.set(event.pointerId, point(event));
+    const start = gesture.current,
+      [a, b] = [...pointers.current.values()];
+    if (!start || !a) return;
+    const middle = b ? { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 } : a;
+    const next =
+      b && start.distance
+        ? atPoint(
+            start.view,
+            start.point,
+            (start.view.scale * Math.hypot(b.x - a.x, b.y - a.y)) /
+              Math.max(1, start.distance),
+          )
+        : start.view;
+    fitted.current = false;
+    setView({
+      ...next,
+      x: next.x + middle.x - start.point.x,
+      y: next.y + middle.y - start.point.y,
+    });
+  };
+  const onPointerEnd = (event: PointerEvent<HTMLDivElement>) => {
+    pointers.current.delete(event.pointerId);
+    startGesture();
+  };
+  return {
+    attachViewport,
+    view,
+    fit,
+    zoom,
+    actualSize,
+    onLoad,
+    onPointerDown,
+    onPointerMove,
+    onPointerEnd,
+  };
+}
